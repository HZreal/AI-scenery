# Add provider credentials here when a demo needs them.
# Keep real secrets in .env, which is ignored by git.

OPENAI_API_KEY=
AI_SCENERY_PROVIDER=mock
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=
MAX_INPUT_CHARS=12000
# Optional: set both rates to calculate cost from OpenAI usage.
OPENAI_INPUT_USD_PER_1M_TOKENS=
OPENAI_OUTPUT_USD_PER_1M_TOKENS=

# Go/Gin LLM API demo. Keep actual values in .env.local.
AI_SCENERY_GO_PROVIDER=mock
GIN_LLM_API_ADDRESS=127.0.0.1:8002
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
